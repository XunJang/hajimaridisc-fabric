{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {},
  "license": "${mod_license}",
  "icon": "assets/hajimaridisc/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "com.xunjang.mc.hajimaridisc.client.HajimariDiscDataGenerator"
    ],
    "client": [
      "com.xunjang.mc.hajimaridisc.client.HajimariDiscClient"
    ],
    "main": [
      "com.xunjang.mc.hajimaridisc.HajimariDisc"
    ]
  },
  "mixins": [
    "hajimaridisc.mixins.json",
    {
      "config": "hajimaridisc.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}"
  }
}
